PROJECT "espai";
BASEPACKAGE "app.espai";

#
#  PRODUCTION TYPES
#

DEFINE MODEL Agency
WITH FIELDS
  name String(200) REQUIRED;

DEFINE MODEL ProductionType
WITH FIELDS
  name String(50) REQUIRED,
  icon String(50) REQUIRED,
  color String(10) REQUIRED,
  active Boolean;

DEFINE MODEL Production
WITH FIELDS
  productionType ProductionType,
  title String(200) REQUIRED,
  subtitle String(200),
  description String,
  durationInMinutes Integer,
  rating Integer,
  recommendedAge Integer,
  available Boolean,
  externalId String(250),
  internalNote String
ON DELETE
  IN ProductionTag DELETE,
  IN ProductionVersion DELETE;

DEFINE ENUM AttachmentType
WITH OPTIONS
  UNSET,
  AUDIO,
  VIDEO,
  IMAGE,
  URL,
  DOWNLOAD;

DEFINE MODEL Attachment
WITH FIELDS
  entityId Long REQUIRED,
  entityType String(100) REQUIRED,
  mediaType AttachmentType REQUIRED,
  mimeType String(100),
  position Integer,
  category String(100),
  caption String(200) REQUIRED,
  location String(300),
  copyright String(300),
  checksum String(100);

DEFINE MODEL AttachmentCategory
WITH FIELDS
  name String(20),
  entityType String(100),
  attachmentType AttachmentType;

DEFINE ENUM FieldType
WITH OPTIONS
  TEXT,
  MULTILINE,
  RICHTEXT,
  INTEGER,
  DECIMAL,
  TAG,
  BOOLEAN,
  DATE,
  DATETIME;

DEFINE MODEL ProductionMetaField
WITH FIELDS
  productionType ProductionType,
  name String(50) REQUIRED,
  label String(50) REQUIRED,
  position Integer,
  fieldType FieldType REQUIRED,
  presets String,
  indexed Boolean,
  facet Boolean;

DEFINE MODEL ProductionMetaValue
WITH FIELDS
  production Production,
  productionMetaField ProductionMetaField,
  position Integer,
  value String;

DEFINE MODEL ProductionVersion
WITH FIELDS
  production Production,
  versionName String(30),
  mediaFormat String(30),
  spokenLanguage String(3),
  audioDescription Boolean,
  subtitles String(3),
  closedCaption Boolean;

DEFINE MODEL ProductionTagTemplate
WITH FIELDS
  name String(50),
  presets String,
  exclusive Boolean;

DEFINE MODEL ProductionTag
WITH FIELDS
  production Production,
  position Integer,
  category String(50),
  value String;

DEFINE MODEL LicenseCondition
WITH FIELDS
  production Production,
  agency Agency,
  commercial Boolean,
  guarantee Monetary,
  fixedPrice Monetary,
  ticketShare Decimal,
  additionalCost Monetary,
  notes String;

DEFINE MODEL ProductionMedium
WITH FIELDS
  production Production,
  name String(150),
  format String(50),
  reference String(300),
  note String;

DEFINE MODEL ProductionCollection
WITH FIELDS
  name String(250) REQUIRED;

DEFINE MODEL ProductionCollectionItem
WITH FIELDS
  collection ProductionCollection REQUIRED,
  production Production REQUIRED;

DEFINE MODEL Presenter
WITH FIELDS
  givenName String(50),
  surname String(50),
  address String(300),
  postcode String(10),
  city String(200),
  phone String(50),
  email String(100);

DEFINE MODEL Venue
WITH FIELDS
  name String(300),
  address String(300),
  postcode String(10),
  city String(100),
  phone String(50),
  email String(150),
  website String(150),
  publicNotes String,
  internalNotes String,
  slug String(200) UNIQUE,
  latitude Decimal,
  longitude Decimal
ON DELETE
  IN SeasonVenue DELETE,
  IN Event DELETE;

DEFINE MODEL VenueContact
WITH FIELDS
  venue Venue REQUIRED,
  position String(50),
  formOfAddress String(100),
  givenName String(100),
  familyName String(100),
  phone String(100),
  email String(150),
  notifyOnReservation Boolean;

DEFINE MODEL Hall
WITH FIELDS
  venue Venue REQUIRED,
  name String(50) REQUIRED,
  capacity Integer,
  wheelchairAccessable Boolean,
  capacityWheelchairs Integer,
  hearingLoops Boolean,
  film35 Boolean,
  film16 Boolean,
  betasp Boolean,
  dvd Boolean,
  bluray Boolean,
  dcp Boolean,
  mpeg Boolean,
  publicNotes String,
  internalNotes String;

DEFINE MODEL SeatCategory
WITH FIELDS
  name String(100),
  description String;

DEFINE MODEL HallCapacity
WITH FIELDS
  seatCategory SeatCategory,
  hall Hall,
  capacity Integer,
  partOfTotalCapacity Boolean;

DEFINE MODEL PriceCategory
WITH FIELDS
  name String(50),
  description String,
  defaultValue Monetary,
  position Integer,
  addByDefault Boolean;

DEFINE MODEL Season
WITH FIELDS
  name String(50),
  start LocalDate,
  end LocalDate,
  archived Boolean,
  mailAccount MailAccount,
  defaultReservationForm ReservationForm REQUIRED
ON DELETE
  IN SeasonProduction DELETE,
  IN SeasonVenue DELETE,
  IN Event DELETE;

DEFINE MODEL SeasonProduction
WITH FIELDS
  season Season,
  production Production,
  internalNote String,
  externalNote String;

DEFINE MODEL SeasonVenue
WITH FIELDS
  season Season REQUIRED,
  venue Venue REQUIRED,
  seasonNotes String,
  selfProgramming Boolean,
  allowFreeBooking Boolean;

DEFINE MODEL SeasonPriceTemplate
WITH FIELDS
  season Season,
  priceCategory PriceCategory,
  price Monetary;

DEFINE MODEL SeasonVenueProduction
WITH FIELDS
  season Season,
  venue Venue REQUIRED,
  production Production REQUIRED;

DEFINE MODEL EventSerial
WITH FIELDS
  name String(150),
  description String,
  season Season
ON DELETE
  IN Event SET NULL;

DEFINE ENUM EventStatus
WITH OPTIONS
  UNSET,
  REQUESTED,
  NORMAL,
  CANCELED,
  POSTPONED,
  VENUE_CHANGED;

DEFINE MODEL Event
WITH FIELDS
  season Season,
  eventSerial EventSerial,
  status EventStatus,
  date LocalDate REQUIRED,
  time LocalTime REQUIRED,
  originalDate LocalDate,
  hall Hall REQUIRED,
  host Presenter,
  coHost Presenter,
  production ProductionVersion REQUIRED,
  internalNote String,
  externalNote String,
  ticketLimit Integer,
  parentEvent Event,
  reservable Boolean,
  mandatory Boolean,
  hidden Boolean,
  reservationForm ReservationForm
ON DELETE
  IN Event DELETE;

DEFINE MODEL EventTicketPrice
WITH FIELDS
  event Event,
  seatCategory SeatCategory,
  priceCategory PriceCategory,
  price Monetary;

DEFINE MODEL EventTicketPriceTemplate
INHERIT FROM EventTicketPrice
WITH FIELDS
  venue Venue,
  hall Hall;

DEFINE ENUM ReservationStatus
WITH OPTIONS
  UNSET,
  NEW,
  HOLD,
  CONFIRMED,
  CANCELED;

DEFINE MODEL Reservation
WITH FIELDS
  status ReservationStatus,
  event Event REQUIRED,
  parentReservation Reservation,
  company String(150),
  givenName String(50),
  surname String(50),
  address String(300),
  postcode String(10),
  city String(200),
  phone String(50),
  email String(100),
  message String,
  internalNotes String,
  termsAccepted Boolean;

DEFINE MODEL ReservationExtra
WITH FIELDS
  reservation Reservation,
  fieldName String(100),
  value String(250);

DEFINE MODEL ReservationSummary
WITH FIELDS
  season Season,
  parentReservation Reservation,
  eventDate LocalDate,
  eventStartTime LocalTime,
  productionTitle String(300),
  production Production,
  event Event,
  venue Venue,
  venueName String(300),
  venueCity String(300),
  company String(150),
  givenName String(50),
  surname String(50),
  tickets Integer,
  message String,
  status ReservationStatus;

DEFINE MODEL TicketSummary
WITH FIELDS
  event Event,
  date LocalDate,
  season Season,
  venue Venue,
  priceCategory PriceCategory,
  seatCategory SeatCategory,
  tickets Integer,
  capacity Integer,
  total Monetary;

DEFINE MODEL ReservationTicket
WITH FIELDS
  reservation Reservation REQUIRED,
  amount Integer,
  priceCategory PriceCategory,
  seatCategory SeatCategory,
  price Monetary;

DEFINE MODEL ReservationForm
WITH FIELDS
  name String(250),
  description String,
  termsConditionsUrl String(250),
  privacyUrl String(250),
  active Boolean;

DEFINE ENUM ReservationFormFieldType
WITH OPTIONS
  TEXT,
  MULTILINE,
  INTEGER,
  DECIMAL,
  BOOLEAN,
  DATE,
  DATETIME,
  DROPDOWN;

DEFINE MODEL ReservationFormField
WITH FIELDS
  reservationForm ReservationForm REQUIRED,
  name String(50) REQUIRED,
  label String(250) REQUIRED,
  position Integer,
  fieldType ReservationFormFieldType REQUIRED,
  presets String,
  required Boolean;

DEFINE MODEL User
WITH FIELDS
  displayName String(100),
  blocked Boolean,
  lastLogin Date
ON DELETE
  IN AccessRight DELETE;

DEFINE MODEL GuiUser
INHERIT FROM User
WITH FIELDS
  email String(100) REQUIRED,
  username String(100) REQUIRED,
  password String(250),
  resetToken String(50),
  resetTokenValid Date;

DEFINE MODEL ApiUser
INHERIT FROM User
WITH FIELDS
  apiToken String(250) REQUIRED;

DEFINE ENUM UserRole
WITH OPTIONS
  MANAGER,
  VENUE_MANAGER;

DEFINE MODEL AccessRight
WITH FIELDS
  user User REQUIRED,
  role UserRole,
  venue Venue;

DEFINE ENUM MailTransportSecurity
WITH OPTIONS
  NONE,
  SSL,
  START_TLS;

DEFINE MODEL MailAccount
WITH FIELDS
  name String(50),
  smtpHost String(150),
  smtpPort Integer,
  smtpTransportSecurity MailTransportSecurity,
  smtpUser String(150),
  smtpPassword String(150),
  imapHost String(150),
  imapPort Integer,
  imapTransportSecurity MailTransportSecurity,
  imapUser String(150),
  imapPassword String(150),
  imapSentFolder String(150);

DEFINE MODEL MailTemplate
WITH FIELDS
  season Season,
  shortCode String(50),
  name String(150),
  description String,
  sender String(250),
  replyTo String(250),
  bcc String(250),
  subject String(250),
  htmlMessage String;

DEFINE MODEL MailSnippet
WITH FIELDS
  active Boolean,
  name String(150) REQUIRED,
  text String REQUIRED;

DEFINE MODEL Task
WITH FIELDS
  title String(250) REQUIRED,
  description String,
  assignee User REQUIRED,
  due Date,
  url String(250),
  done Boolean;